# development | production | test
NODE_ENV=development
PORT=4000
# Bearer token Vercel Cron sends to /schedules/one/weekly/cron; leave unset to allow any caller
# CRON_SECRET=
# Vercel Blob read-write token, added by Vercel when a Blob store is connected
# BLOB_READ_WRITE_TOKEN=
# Hapag-Lloyd Commercial Schedules API (api-portal.hlag.com): full point-to-point-routes URL and app credentials
# HLAG_API_URL=
# HLAG_CLIENT_ID=
# HLAG_CLIENT_SECRET=
